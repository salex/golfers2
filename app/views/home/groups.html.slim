div.hidden.bg-blue-500.bg-red-500.bg-orange-500.bg-purple-500.bg-green-500.bg-green-600.bg-green-700.text-green-600.text-green-200

div[class="font-bold text-lg p-1 pl-4 -mx-2 bg-lime text-2xl flex"] 
  div.flex-shrink
    span.font-bold.flex-shrink[style="text-transform:none;" ]PtGolf
    span.font-bold[style="text-transform:none;font-size:.5rem;"].us 
  span.flex-grow.font-bold.text-center Home Page


  span.float-right.text-green-800.p-0.font-bold.mr-3.hover:text-2xl = link_to icon('fas fa-arrow-left'), 'javascript:history.back()'


div.flex.flex-wrap.gap-8.p-2

  div.card-4.bg-lime-lightest.h-70

    table.golfer.m-2.bg-white.w-fit
      caption.font-lg.font-bold Current Groups
      thead
        tr
         
          th.p-2 Group Name
          th.p-2 Players
          th.p-2 Games
          th.p-2 Last Game
          th.p-2 Visit/Leave
      tbody
        tr
        - groups = Group.all.order(:name)
        - groups.each do |group|
          tr
            td = group.name
            td.text-center = group.players.size
            td.text-center = group.games.size
            td.text-center = group.games.last.date
            td
              - if Current.group && Current.group.id == group.id
                = linkBtn('Exit and Leave',leave_group_path(group),meth:'patch',klass:"btn-md bg-lime-darker w-full py-0")
              - else
                = linkBtn('Visit',visit_group_path(group),meth:'patch',klass:"btn-md bg-lime-darker w-full text-center py-0")
  / div side
  div.w-140
    strong.fs2 Welcome to PointGolf (PtGolf.us)
    p.slim.mb-2 A Web tool for managing quotas for your golf groups Low Ball or Dog Fight games.
    p.slim.mb-2 If your are a Member of a Group - SignIn using the SignIn links/button.
    p.slim.mb-2 If just visiting, select a Group by clicking one the 'Visit' link in the Current Groups list on the left. Once you visit a group you will go directly to that group's home page. If you leave the group, you can visit another group.
    .button-bar
      .annotate Learn more about PtGolf by clicking on the About link.
      button.text-green-700.hover:text-blue-700.text-lg.font-bold = link_to 'About PtGolf.us', '/about'

    p.slim.mb-2 PtGolf.us is currently in limited production with only Clubs/Groups personally known by the author. 
    /If you like to inquire about adding you Club/Group, please click the <b>Contact Us</b> button below and provide contact information.
    / .button-bar
        / button.lime-link-btn = link_to 'Contact Us', '/inquiries/new'


