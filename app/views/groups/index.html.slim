div.w-full
  p style="color: green" = notice
  div.flex.bg-lime-light.-mx-2.gap-4.mb-1.p-1.border-b-2.border-green-400
    h1.font-bold.text-2xl.flex-shrink Groups
    div.flex-grow.flex
      = link_to link_to icon('fas fa-plus-square', "New Group"), new_group_path,class:"btn-sm-blue"
  hr.border-1.border-blue-500.my-1


  #groups
    - @groups.each do |group|
      .flex.gap-4.p-2.font-bold
        .w-12 = "Id: #{group.id}"

        .w-36 = "Name: #{group.name}"
        = link_to icon('fas fa-eye',"Show Group"), group,class:"btn-sm-green"
        = link_to icon('fas fa-edit',"Edit Group"),  edit_group_path(group),class:"btn-cancel"

      hr.border-1.border-blue-500.my-1

