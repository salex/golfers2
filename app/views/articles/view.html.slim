div.w-full
  div.print:hidden
    p style="color: green" = notice
    div.flex.gap-8.bg-lime-lighter

      h1.font-bold.text-2xl Viewing Article

      =< link_to icon('fas fa-list',"List Articles"), articles_path, class:"btn-link"
    hr.border-1.border-blue-500.my-1

  div.mx-auto.w-full.z-0
    div.flex.gap-4.font-bold
      div = "Date: #{@article.created_at.to_fs(:long)}"

    - if @article.content.include?('.slimtext')
      - page =  Slim::Template.new{|t| @article.content}
      = page.render.html_safe
    - else
      div.border.p-2[data-controller="displayMarked"]
        div.hidden = text_area_tag('x',@article.content, data:{displayMarked_target:"markup"})
        h3.text-xl.font-bold = @article.title
        div.marked[data-displayMarked-target='viewer']
