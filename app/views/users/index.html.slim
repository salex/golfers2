p style="color: green" = notice

div.flex.bg-lime-light.gap-4.-mx-2.mb-1.p-1.border-b-2.border-green-400
  h1.font-black.text-2xl.flex-shrink Users
  div.flex-grow.flex-wrap.gap-4
    = link_to link_to icon('fas fa-plus-square', "New User"), new_user_path,class:"btn-sm-blue"
  div.flex-shrink.text-green-800.p-0.font-bold.mr-3.hover:text-2xl = link_to icon('fas fa-arrow-left'), 'javascript:history.back()'
hr.border-1.border-blue-500.my-1

div.w-full
  #users
    table.golfer
      thead
        tr
          th User Name
          th Id
          th Group
          th uName
          th Role
          th eMail
          th Actions
      tbody
        - @users.each do |user|
          tr
            td =< user.fullname
            td =< user.id
            td =< user.group.name
            td =< user.username
            td =< user.role
            td =< user.email
            td 
              = link_to icon('fas fa-eye',"Show User"), user,class:"btn-sm-green"
              = link_to icon('fas fa-edit',"Edit User"),  edit_user_path(user),class:"btn-cancel"


